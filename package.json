{
  "name": "dsh-anti-interrupt",
  "version": "1.0.0",
  "description": "DSH 长任务防中断：被杀或崩溃后自动接上被打断的回合；Windows 上还能关掉屏保和睡眠，不让任务停在半路。",
  "type": "module",
  "main": "index.js",
  "icon": "assets/icon.png",
  "exports": {
    ".": "./index.js",
    "./icon": "./assets/icon.png",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**",
    "scripts/**",
    "locale/*.json",
    "assets/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "anti-interrupt",
    "auto-resume",
    "crash-recovery",
    "nightwatch",
    "continuity",
    "screensaver",
    "power",
    "windows"
  ],
  "license": "MIT",
  "author": "ingk888766-cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingk888766-cloud/dsh-anti-interrupt.git"
  },
  "homepage": "https://github.com/ingk888766-cloud/dsh-anti-interrupt#readme",
  "bugs": {
    "url": "https://github.com/ingk888766-cloud/dsh-anti-interrupt/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  }
}
